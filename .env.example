# =============================================================================
# SkyWing Airlines - Multi-Agent RAG System - Environment Template
# =============================================================================
# Copy this file to .env and customize values for your environment.
# For local development, you can use sensible defaults below.
# For production, update with real credentials and change API_KEY.
# =============================================================================

# === Azure OpenAI (Optional - only if using Azure embeddings) ===
# Leave empty or set to "local" to use local BGE embeddings (no Azure required)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# === Embedding Provider ===
# Set to "local" for free local BGE embeddings (default, recommended for dev)
# Set to "azure" to use Azure OpenAI embeddings (requires AZURE_* credentials above)
EMBEDDING_PROVIDER=local

# === PostgreSQL Database ===
# Database connection credentials for persistent storage
DB_USER=rag_user
DB_PASSWORD=rag_password
DB_NAME=rag_db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@postgres:5432/rag_db

# === Redis Cache & Task Queue ===
# Redis connection for caching and ARQ background job processing
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# === ChromaDB Vector Store ===
# ChromaDB container port and API URL for semantic search
CHROMA_PORT=8001
CHROMA_API_URL=http://chromadb:8000

# === API & Server Configuration ===
# FastAPI port and environment (development/staging/production)
API_PORT=8000
ENVIRONMENT=development

# === Frontend Configuration ===
# Frontend port and API URL for browser clients
FRONTEND_PORT=3000
VITE_API_URL=http://localhost/api

# === API Security ===
# Change this to a secure random value in production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-change-in-production

# === Logging ===
# Log level for application and worker processes
LOG_LEVEL=INFO

# === Optional: LangSmith Observability ===
# Uncomment and set these to enable LangSmith tracing for agent debugging
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
