# Universal RAG configuration

# LLM: openai, azure, or mock. "mock" never calls an external service.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Azure alternative (used only when LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Embeddings: local, openai, or azure.
# BGE-M3 is multilingual. Changing the embedding model requires re-indexing.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Each child directory becomes a knowledge base.
DATA_DIR=/data

DB_USER=rag_user
DB_PASSWORD=change-me
DB_NAME=rag_db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:change-me@postgres:5432/rag_db

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
# Optional for managed Redis providers that expose only database 0.
ARQ_REDIS_URL=

CHROMA_PORT=8001
CHROMA_PROVIDER=http
CHROMA_API_URL=http://chromadb:8000
# Chroma Cloud (used when CHROMA_PROVIDER=cloud)
CHROMA_CLOUD_HOST=api.trychroma.com
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_API_KEY=

API_PORT=8000
API_KEY=replace-with-a-random-secret
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGIN_REGEX=
ENABLE_EVALUATION=true

FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost/api/v1
VITE_API_KEY=replace-with-a-random-secret

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
